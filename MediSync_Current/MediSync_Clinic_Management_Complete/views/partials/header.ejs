<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>
        <%= title %> | MediSync
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <header class="topbar"><a class="brand" href="<%= admin?'/':'/admin/login' %>">Medi<span>Sync</span></a>
        <% if(admin){ %>
            <nav><a href="/">Dashboard</a>
                <a href="/patients">Patients</a>
                <a href="/doctors">Doctors</a>
                <a href="/doctor/login">Doctor portal</a>
                <a href="/appointments">Appointments</a>
                <a href="/queue">OPD Queue</a>
                <a href="/reports">Reports</a>
                <a href="/online-appointments">Online Appointments</a>
                <a href="/admin/system-health">
                    System Health
                </a>
            </nav>
            <form method="post" action="/admin/logout"><button class="logout">Logout · <%= admin.username %></button>
            </form>
            <% } %>
    </header>
    <main class="container">
        <% if(notice){ %>
            <div class="toast">
                <%= notice.replace(/\+/g,' ') %></div><% } %>